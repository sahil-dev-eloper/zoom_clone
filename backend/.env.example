# Database URL
DATABASE_URL=sqlite:///./zoom_clone.db

# Frontend origin (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# STUN server (comma-separated or single URL)
STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN server for users behind symmetric NAT / corporate firewalls
# Clients securely fetch ephemeral/backend-provided ICE configurations via GET /api/ice-servers
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password
